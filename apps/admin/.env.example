# .env.local 로 복사해 쓴다. REST 경로는 /api/... 로 붙는다(명세 12.6).
# 비우면 화면과 같은 출처로 부른다. 실서버로 갈 경로는 개발 서버가 API_PROXY_TARGET 으로 넘긴다
# (mock 을 끄면 /api 전체, 켜면 VITE_API_REAL 경로만). 갱신 쿠키가 실리고 CORS 가 필요 없다.
VITE_API_BASE_URL=
# 개발 서버 프록시가 넘길 실서버(http(s) 주소). 로컬 서버면 http://localhost:8080. 브라우저 번들에는 들어가지 않는다.
API_PROXY_TARGET=https://simai.live
# STOMP 엔드포인트 경로는 서버와 정해지면 바꾼다.
VITE_STOMP_URL=ws://localhost:8080/ws
# true 면 개발 서버가 msw 로 REST·STOMP 를 흉내 낸다(src/mocks).
VITE_API_MOCK=true
# mock 을 켠 채 실서버로 보낼 경로(쉼표로 나눈다). 비우면 모두 mock(계정은 src/mocks/accounts.ts).
# /api/auth 를 적으면 로그인·갱신·로그아웃만 실서버로 가고 실서버 계정으로 로그인한다.
VITE_API_REAL=
# CCTV 화면의 현장 노트북 로컬 미리보기(영상 중계 --preview-port, 127.0.0.1 에서만 듣는다). 비우면 기본값 ws://127.0.0.1:47032.
# 루프백 주소만 받는다. 1.5초 안에 열리지 않으면 VITE_STOMP_URL 과 같은 EC2 의 원격 시청(/ws/cctv/view)으로 붙는다.
VITE_CCTV_PREVIEW_URL=
